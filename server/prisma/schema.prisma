generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Habit {
  id             String   @id @default(uuid())
  name           String
  description    String?
  color          String
  createdAt      DateTime @default(now())
  
  // Массив строк для отметок (формат YYYY-MM-DD)
  completedDates String[] @default([])
}